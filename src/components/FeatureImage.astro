---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ImageCredit from './ImageCredit.astro';
type Hero = NonNullable<CollectionEntry<'blog'>['data']['hero']>;
interface Props { hero: Hero; }
const { hero } = Astro.props;
const caption = hero.credit && hero.caption?.toLowerCase().startsWith('photo by ')
  ? undefined
  : hero.caption;
---
<figure class="feature-figure"><Image class="feature-image" src={hero.image} alt={hero.alt} widths={[640, 960, 1280]} sizes="(max-width: 820px) 100vw, 820px" />{(caption || hero.credit) && <figcaption>{caption && <span>{caption}</span>}{hero.credit && <ImageCredit credit={hero.credit} />}</figcaption>}</figure>
