---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { postPath, tagLabel, tagPath } from '../lib/routes';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { title, description, pubDate, tags, hero } = post.data;
if (!pubDate) throw new Error(`Published post ${post.id} has no pubDate`);
---
<article class="post-card">{hero && <a class="post-card-image" href={postPath(post.id)} tabindex="-1" aria-hidden="true"><Image src={hero.image} alt="" widths={[320, 480]} sizes="208px" loading="lazy" /></a>}<div><FormattedDate date={pubDate} /><h2><a href={postPath(post.id)}>{title}</a></h2>{description && <p>{description}</p>}{tags.length > 0 && <ul class="tag-list" aria-label="Tags">{tags.map((tag) => <li><a href={tagPath(tag)}>#{tagLabel(tag)}</a></li>)}</ul>}</div></article>
