---
import type { ImageCredit } from '../config/types';
interface Props { credit: ImageCredit; }
const { credit } = Astro.props;
const prefix = credit.kind === 'screenshot' ? 'Screenshot by' : credit.kind === 'artwork' ? 'Artwork by' : 'Photo by';
---
<span class="image-credit">
  {prefix} {credit.creatorUrl ? <a href={credit.creatorUrl}>{credit.creator}</a> : credit.creator}
  {credit.provider && <> on {credit.sourcePageUrl ? <a href={credit.sourcePageUrl}>{credit.provider} — view original</a> : credit.providerUrl ? <a href={credit.providerUrl}>{credit.provider}</a> : credit.provider}</>}.
</span>
