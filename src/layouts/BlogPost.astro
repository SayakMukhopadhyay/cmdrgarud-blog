---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FeatureImage from '../components/FeatureImage.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { tagLabel, tagPath } from '../lib/routes';
type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, tags, hero } = Astro.props;
if (!pubDate) throw new Error(`Published post ${title} has no pubDate`);
const showUpdated = updatedDate && updatedDate.getTime() !== pubDate.getTime();
---
<BaseLayout title={title} description={description} image={hero?.image} type="article" pubDate={pubDate} updatedDate={showUpdated ? updatedDate : undefined}><article class="article"><header class="article-header"><FormattedDate date={pubDate} />{showUpdated && <p class="updated-date">Updated <FormattedDate date={updatedDate} /></p>}<h1>{title}</h1>{tags.length > 0 && <ul class="tag-list" aria-label="Tags">{tags.map((tag) => <li><a href={tagPath(tag)}>#{tagLabel(tag)}</a></li>)}</ul>}</header>{hero && <FeatureImage hero={hero} />}<div class="prose"><slot /></div></article></BaseLayout>
