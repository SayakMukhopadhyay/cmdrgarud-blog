---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../site';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: ImageMetadata; type?: 'website' | 'article'; pubDate?: Date; updatedDate?: Date; canonicalPath?: string; }
const props = Astro.props;
---
<!doctype html><html lang={siteConfig.locale} style={`--accent: ${siteConfig.accentColor}`}><head><BaseHead {...props} /></head><body><a class="skip-link" href="#main-content">Skip to content</a><div class="shell"><SiteHeader /><main id="main-content"><slot /></main><Footer /></div></body></html>
