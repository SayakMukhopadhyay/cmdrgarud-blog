---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import FeatureImage from '../components/FeatureImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { tagPath } from '../lib/routes';

type Props =
  | { kind: 'post'; entry: CollectionEntry<'posts'> }
  | { kind: 'page'; entry: CollectionEntry<'pages'> };

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return [
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'post' as const, entry } })),
    ...pages.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'page' as const, entry } })),
  ];
}

const props = Astro.props as Props;
const rendered = props.kind === 'post' ? await render(props.entry) : await render(props.entry);
const { Content } = rendered;
const data = props.entry.data;
const featureImage = 'featureImage' in data ? data.featureImage : undefined;
const featureImageCaption = 'featureImageCaption' in data ? data.featureImageCaption : undefined;
const featureImageCaptionLinks = 'featureImageCaptionLinks' in data ? data.featureImageCaptionLinks : undefined;
---

<BaseLayout title={data.title} description={data.description}>
  <article class="article">
    <header class="article-header">
      {props.kind === 'post' && props.entry.data.publishedAt && <time datetime={props.entry.data.publishedAt.toISOString()}>{props.entry.data.publishedAt.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
      <h1>{data.title}</h1>
      {props.kind === 'post' && props.entry.data.tags.length > 0 && <ul class="tag-list" aria-label="Tags">{props.entry.data.tags.map((tag) => <li><a href={tagPath(tag)}>#{tag}</a></li>)}</ul>}
    </header>
    {featureImage && <FeatureImage src={featureImage} caption={featureImageCaption} links={featureImageCaptionLinks} />}
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
