---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found." canonicalPath="/404.html">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The address may have changed while this site was being rebuilt.</p>
    <p><a href="/">Return home</a></p>
  </section>
</BaseLayout>
