---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { authorPath } from '../lib/routes';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0));
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">{siteConfig.author.location}</p>
      <h1>{siteConfig.title}</h1>
      <p>{siteConfig.description}</p>
      {siteConfig.author.bio && <p class="hero-bio">{siteConfig.author.bio} <a href={authorPath()}>About the author</a></p>}
    </div>
    <img src={siteConfig.coverImage} alt="" />
  </section>

  <section aria-labelledby="latest-posts">
    <h2 class="section-title" id="latest-posts">Latest writing</h2>
    <div class="post-list">
      {posts.map((post) => post.data.publishedAt && <PostCard slug={post.id} title={post.data.title} description={post.data.description} publishedAt={post.data.publishedAt} tags={post.data.tags} featureImage={post.data.featureImage} />)}
    </div>
  </section>
</BaseLayout>
